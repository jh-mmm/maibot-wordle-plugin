{
  "manifest_version": 2,
  "id": "jh-mmm.maibot-wordle-plugin",
  "name": "Wordle 猜单词",
  "version": "1.0.3",
  "description": "经典的 5 字母 Wordle 猜单词游戏插件，支持精美卡片渲染、虚拟键盘状态高亮、单词释义与战绩统计。",
  "author": {
    "name": "jh-mmm",
    "url": "https://github.com/jh-mmm"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/jh-mmm/maibot-wordle-plugin",
    "homepage": "https://github.com/jh-mmm/maibot-wordle-plugin",
    "documentation": "https://github.com/jh-mmm/maibot-wordle-plugin#readme",
    "issues": "https://github.com/jh-mmm/maibot-wordle-plugin/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "plugin_type": "game",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.svg",
      "fallback": "gamepad-2"
    }
  },
  "capabilities": [
    "send.text",
    "send.image",
    "render.html2png"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN", "en-US"]
  }
}
